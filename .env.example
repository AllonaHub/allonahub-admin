# Public frontend config
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx"
SITE_URL="https://allonahub.com"
API_URL="https://api.allonahub.com"
ALLOWED_ORIGINS="https://allonahub.com,https://www.allonahub.com,https://admin.allonahub.com"
