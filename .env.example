ASSISTANT_AI_TEMPERATURE="0.2"
ASSISTANT_AI_TIMEOUT_MS="12000"
ASSISTANT_MAX_MESSAGE_CHARS="1600"
ASSISTANT_MAX_REPLY_CHARS="700"
ASSISTANT_RATE_LIMIT_MAX="20"
ASSISTANT_TELEGRAM_BOT_TOKEN=""
