# Public frontend config
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx"
SITE_URL="https://allonahub.com"
API_URL="https://api.allonahub.com"
ALLOWED_ORIGINS="https://allonahub.com"
ALLOWED_HOSTS="api.allonahub.com,admin.allonahub.com,localhost,127.0.0.1"
ADMIN_HOSTS="admin.allonahub.com,api.allonahub.com"
ADMIN_IP_ALLOWLIST=""
MFA_REQUIRED_ROLES="partner,courier,admin,super_admin"
AUDIT_LOG_ENABLED="true"
MAINTENANCE_MODE="false"
EMERGENCY_API_DISABLED="false"
PAYMENTS_DISABLED="false"

# Server-only Supabase / Edge Function secrets
# Never expose these in frontend HTML, CSS or browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# iyzico server-only secrets
IYZICO_API_KEY="replace-with-iyzico-api-key"
IYZICO_SECRET_KEY="replace-with-iyzico-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
IYZICO_CALLBACK_URL="https://your-project.supabase.co/functions/v1/iyzico-callback"

# Product settings
CV_PRICE_TRY="149.99"
CRON_SECRET="replace-with-long-random-secret"
