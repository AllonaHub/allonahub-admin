# Server-only Supabase / Edge Function secrets
# Never expose these in frontend HTML, CSS or browser JavaScript.
SUPABASE_SECRET_KEY="replace-with-supabase-sb-secret-key"
SUPABASE_SERVICE_ROLE_KEY="legacy-fallback-only"
TURNSTILE_SECRET_KEY="replace-with-cloudflare-turnstile-secret-key"

